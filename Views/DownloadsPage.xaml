<Page
    x:Class="AkariOSCompanion.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AkariOSCompanion.ViewModels"
    Title="Downloads"
    d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Margin="36,26,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Action bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Content="Install Selected"
                           Command="{Binding InstallSelectedCommand}"
                           IsEnabled="{Binding SelectedCount, Converter={StaticResource CountToBool}}" />
                <ui:Button Appearance="Secondary" Content="Cancel" Margin="10,0,0,0"
                           Command="{Binding ClearSelectionCommand}" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#24D92D39" BorderBrush="{StaticResource AkariBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="15,5">
                <TextBlock Foreground="{StaticResource AkariCrimsonLight}" FontSize="12">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" selected" />
                </TextBlock>
            </Border>
        </Grid>

        <!-- Search + category chips -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <ui:TextBox PlaceholderText="Search applications..." Width="300" HorizontalAlignment="Left"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <ItemsControl ItemsSource="{Binding Categories}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Content="{Binding}" Margin="4,0,0,0"
                                      Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Foreground" Value="{StaticResource AkariTextDim}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="chip" Background="#8C1E0C0E"
                                                        BorderBrush="{StaticResource AkariBorder}" BorderThickness="1"
                                                        CornerRadius="8" Padding="16,7">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- active when this chip's text == VM.SelectedCategory -->
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource CategoryActive}">
                                                                <Binding />
                                                                <Binding Path="DataContext.SelectedCategory"
                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="chip" Property="Background" Value="{StaticResource AkariCrimson}" />
                                                        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AkariCrimson}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- result meta -->
        <TextBlock Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource Caption}"
                   Text="{Binding StatusText}" />

        <!-- Card grid -->
        <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AppsView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Width="280" Height="150" Margin="0,0,14,14"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="card" Background="{StaticResource AkariCard}"
                                            BorderBrush="{StaticResource AkariBorder}" BorderThickness="1"
                                            CornerRadius="14" Padding="18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- header: monogram + name + category -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <Border Width="46" Height="46" CornerRadius="12"
                                                        Background="#22E0303A">
                                                    <TextBlock Text="{Binding Mono}"
                                                               FontFamily="{StaticResource AkariDisplay}"
                                                               FontSize="20" FontWeight="Bold"
                                                               Foreground="{Binding Category, Converter={StaticResource CategoryToBrush}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center" Width="170">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{StaticResource AkariDisplay}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="{StaticResource AkariText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Category, Converter={StaticResource CategoryToBrush}}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                       Style="{StaticResource Caption}" FontSize="12.5"
                                                       Margin="0,13,0,0" />

                                            <!-- footer: license + action -->
                                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                                <Border HorizontalAlignment="Left" BorderBrush="#595FD47A"
                                                        BorderThickness="1" CornerRadius="5" Padding="10,3">
                                                    <TextBlock Text="Free" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{StaticResource AkariFree}" />
                                                </Border>
                                                <TextBlock x:Name="action" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Text="{Binding IsSelected, Converter={StaticResource SelectedToLabel}}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource AkariMuted}" />
                                            </Grid>

                                            <!-- selected check badge -->
                                            <Border x:Name="badge" Grid.Row="0" Width="22" Height="22" CornerRadius="11"
                                                    Background="{StaticResource AkariCrimson}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="Background" Value="{StaticResource AkariCardHover}" />
                                            <Setter TargetName="card" Property="BorderBrush" Value="#66E0303A" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AkariCrimson}" />
                                            <Setter TargetName="card" Property="Background" Value="{StaticResource AkariCardHover}" />
                                            <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="action" Property="Foreground" Value="{StaticResource AkariCrimsonLight}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
