<Page
    x:Class="AkariOSCompanion.Views.MiscPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AkariOSCompanion.ViewModels"
    Title="Misc"
    d:DataContext="{d:DesignInstance Type=vm:MiscViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,40,80">

            <TextBlock Text="Context Menu" Style="{StaticResource PageTitle}" FontSize="18" />
            <TextBlock Text="Add or remove entries from the Windows right-click context menu."
                       Style="{StaticResource Caption}" Margin="0,5,0,0" />

            <Border Style="{StaticResource AkariCardBorder}" Margin="0,22,0,0">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource AkariBorderSoft}" BorderThickness="0,0,0,1" Padding="22,15">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5"
                                                   Foreground="{StaticResource AkariText}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                   FontSize="12.5" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ui:Button Content="Add" Appearance="Danger" Width="84" Margin="0,0,9,0"
                                                   Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding Key}" />
                                        <ui:Button Content="Remove" Appearance="Secondary" Width="84"
                                                   Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding Key}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
