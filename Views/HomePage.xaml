<Page
    x:Class="AkariOSCompanion.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AkariOSCompanion.ViewModels"
    Title="Home"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,40">

            <!-- Page heading -->
            <TextBlock Text="Akari OS Companion"
                       FontFamily="{StaticResource AkariDisplay}"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource AkariText}" />
            <TextBlock Text="Your control center for Akari OS — tuning, tweaks &amp; utilities"
                       FontSize="13" Foreground="{StaticResource AkariMuted}"
                       Margin="0,5,0,0" />

            <!-- Section label -->
            <TextBlock Text="QUICK ACCESS"
                       FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{StaticResource AkariFaint}"
                       Margin="0,26,0,14"
                        />

            <!-- 2×2 quick-access cards -->
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,16,16"
                                Height="120"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Target}"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="#8C1E1E1E"
                                            BorderBrush="#26FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="26,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Grey icon square -->
                                            <Border Grid.Column="0"
                                                    Width="56" Height="56"
                                                    CornerRadius="13"
                                                    Background="#30323434"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="26"
                                                           Foreground="{StaticResource AkariGrey}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Title + description -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="20,0,0,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource AkariDisplay}"
                                                           FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource AkariText}" />
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="13.5"
                                                           Foreground="{StaticResource AkariMuted}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Chevron -->
                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="#55323434"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#B32A2A2A" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#55323434" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#CC333333" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
