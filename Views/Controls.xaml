<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AkariOSCompanion.Converters">

    <!-- ===== Shared converters ===== -->
    <conv:InverseBoolConverter     x:Key="InverseBool" />
    <conv:CountToBoolConverter     x:Key="CountToBool" />
    <conv:CategoryToBrushConverter x:Key="CategoryToBrush" />
    <conv:SelectedToLabelConverter x:Key="SelectedToLabel" />
    <conv:CategoryActiveConverter  x:Key="CategoryActive" />

    <!-- ===== Typography ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AkariDisplay}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AkariText}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AkariDisplay}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AkariGreyLight}" />
        <Setter Property="Margin" Value="0,24,0,12" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource AkariMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Card surface ===== -->
    <Style x:Key="AkariCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AkariCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource AkariBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="TweakRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AkariCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource AkariBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,13" />
    </Style>

    <!-- ===== Vendor / GPU button ===== -->
    <Style x:Key="VendorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource AkariTextDim}" />
        <Setter Property="Background" Value="#8C242424" />
        <Setter Property="BorderBrush" Value="{StaticResource AkariBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#28343434" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AkariGrey}" />
                            <Setter Property="Foreground" Value="{StaticResource AkariText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#40343434" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== NavigationViewItem — text-only, grey left accent bar on selection ===== -->
    <Style x:Key="AkariNavItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AkariMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- Outer border provides the hover/selected background -->
                    <Border x:Name="bg" Background="Transparent" CornerRadius="0">
                        <!-- Grid lets us layer accent bar + text side by side -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left accent bar -->
                            <Rectangle x:Name="accent"
                                       Grid.Column="0"
                                       Fill="Transparent"
                                       RadiusX="0" RadiusY="0" />

                            <!-- Item content (text) -->
                            <ContentPresenter Grid.Column="1"
                                              Margin="15,10,16,10"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#12FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource AkariTextDim}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#18323434" />
                            <Setter TargetName="accent" Property="Fill" Value="{StaticResource AkariGrey}" />
                            <Setter Property="Foreground" Value="{StaticResource AkariText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
