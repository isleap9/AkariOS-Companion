<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AkariOSCompanion.Converters">

    <!-- ===== Shared converters ===== -->
    <conv:InverseBoolConverter      x:Key="InverseBool" />
    <conv:CountToBoolConverter      x:Key="CountToBool" />
    <conv:CategoryToBrushConverter  x:Key="CategoryToBrush" />
    <conv:SelectedToLabelConverter  x:Key="SelectedToLabel" />
    <conv:CategoryActiveConverter   x:Key="CategoryActive" />

    <!-- ===== Page heading ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AkariDisplay}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AkariText}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AkariDisplay}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AkariCrimsonLight}" />
        <Setter Property="Margin" Value="0,28,0,14" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource AkariMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Card surface ===== -->
    <Style x:Key="AkariCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AkariCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource AkariBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- A tweak row: title + description on the left, ToggleSwitch on the right -->
    <Style x:Key="TweakRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AkariCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource AkariBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!-- ===== Gaming-tweak / vendor button ===== -->
    <Style x:Key="VendorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{StaticResource AkariTextDim}" />
        <Setter Property="Background" Value="#8C1E0C0E" />
        <Setter Property="BorderBrush" Value="{StaticResource AkariBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#26E0303A" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AkariCrimson}" />
                            <Setter Property="Foreground" Value="{StaticResource AkariText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
